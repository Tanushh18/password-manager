{
  "manifest_version": 3,
  "name": "Stashr Autofill",
  "version": "1.0.1",
  "description": "Fill your saved Stashr logins on any website with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://password-manager-server-8gvj.onrender.com/*",
    "https://password-manager-server-xxdr.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stashr Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
