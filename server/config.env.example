# Copy to config.env (git-ignored) and fill in.
MONGO_URL=mongodb+srv://user:pass@cluster.example.mongodb.net/aurelia
SECRET_KEY=change-me-to-a-long-random-string
CRYPTO_SECRET_KEY=change-me-to-another-long-random-string
# CLIENT_ORIGINS=https://my-site.example.com
# SELF_URL=https://my-api.onrender.com
# KEEP_ALIVE=false

# Persistent Render monitoring scheduler secret (generate a long random value).
# Configure the same value in the trusted scheduler's Authorization: Bearer header.
# RENDER_MONITOR_CRON_SECRET=replace-with-a-long-random-secret

# Optional Groq-powered diagnosis. Requires user consent in the dashboard.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
