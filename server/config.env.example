# Copy to config.env (git-ignored) and fill in.
MONGO_URL=mongodb+srv://user:pass@cluster.example.mongodb.net/aurelia
SECRET_KEY=change-me-to-a-long-random-string
CRYPTO_SECRET_KEY=change-me-to-another-long-random-string
# CLIENT_ORIGINS=https://my-site.example.com
# SELF_URL=https://my-api.onrender.com
# KEEP_ALIVE=false

# Photo Cloud Google OAuth. Configure the same redirect URI in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PHOTO_REDIRECT_URI=https://your-api.example.com/photo-cloud/google/callback
# PHOTO_CLOUD_CLIENT_URL=https://your-web.example.com
# GOOGLE_PHOTO_SCOPES=openid email https://www.googleapis.com/auth/drive.readonly

# Persistent Render monitoring scheduler secret (generate a long random value).
# Configure the same value in the trusted scheduler's Authorization: Bearer header.
# RENDER_MONITOR_CRON_SECRET=replace-with-a-long-random-secret

# Optional Groq-powered diagnosis. Requires user consent in the dashboard.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Forgot password: 6-digit code by email through Brevo (https://app.brevo.com → SMTP & API → API keys)
BREVO_API_KEY=xkeysib-...
# Must be a sender verified in Brevo (Senders, domains & IPs)
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=Stashr

# Optional photo worker servers (extra copies of this server that scan Drive and stream previews).
# Set the same secret on this server and on every worker; list the workers' https URLs here.
# PHOTO_WORKER_URLS=https://photo-worker-1.onrender.com,https://photo-worker-2.onrender.com,https://photo-worker-3.onrender.com
# PHOTO_WORKER_SECRET=<long random string>

# Google Photos -> Drive import worker. On by default. Set to false on the main server once your processing servers run it.
# PHOTO_IMPORT_WORKER=true
# How many files one server moves at once (1 = strictly one after another).
# PHOTO_IMPORT_PARALLEL=1
