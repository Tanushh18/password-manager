# Stashr API server environment.
# Copy this file to config.env in this directory. Never commit config.env.
# Use real secrets only in your local environment or hosting provider's secret store.

# Required: MongoDB connection string (local or MongoDB Atlas).
MONGO_URL=mongodb://127.0.0.1:27017/stashr

# Required: random, unique secrets. Generate independently with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep SECRET_KEY and CRYPTO_SECRET_KEY separate and stable for a deployment.
SECRET_KEY=replace-with-a-random-secret
CRYPTO_SECRET_KEY=replace-with-a-different-random-secret

# Optional database aliases accepted by server/db/connection.js:
# DATABASE=
# MONGODB_URI=

# Runtime / networking.
NODE_ENV=development
PORT=8000
# Comma-separated browser/extension origins allowed by CORS.
# CLIENT_ORIGINS=http://localhost:3000,https://your-web.example
# Comma-separated Chrome extension origins (exact extension IDs).
# EXTENSION_ORIGINS=chrome-extension://replace-with-extension-id
# Public URL of this server for health pinging/worker callbacks.
# SELF_URL=https://your-api.example
# KEEP_ALIVE=false
# KEEP_ALIVE_MINUTES=14

# Google OAuth for Photo Cloud. Register the exact redirect URI in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PHOTO_REDIRECT_URI=https://your-api.example/photo-cloud/google/callback
# PHOTO_CLOUD_CLIENT_URL=https://your-web.example
# GOOGLE_PHOTO_SCOPES=openid email https://www.googleapis.com/auth/drive.readonly

# Monitoring scheduler. Configure the same value on the trusted scheduler's
# Authorization: Bearer header for POST /render/ops/tick.
# RENDER_MONITOR_CRON_SECRET=replace-with-a-long-random-secret

# Transactional email / password reset codes (Brevo).
# Only set a real API key in your local config.env or hosting secrets.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Stashr

# Optional Groq-powered diagnostics (feature/consent dependent).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional photo worker fleet. Use HTTPS URLs and one shared random secret
# only among your own trusted workers.
# PHOTO_WORKER_URLS=https://photo-worker.example
# PHOTO_WORKER_SECRET=replace-with-a-long-random-secret
# PHOTO_IMPORT_WORKER=true
# PHOTO_IMPORT_PARALLEL=1

# Optional values consumed by integrations / worker processes.
# HASH_KEY=legacy-alias-for-CRYPTO_SECRET_KEY
# Add integration-specific secrets only when you have verified which feature
# consumes them; never use real credentials as sample values.
