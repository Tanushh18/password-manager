{
  "expo": {
    "name": "Stashr",
    "slug": "aurelia-vault",
    "scheme": "aurelia",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0303",
    "description": "Stashr — a private vault for every password and project. Same account and server as the Stashr website.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurelia.vault"
    },
    "android": {
      "package": "com.aurelia.vault",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#31AAA9"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0303",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock your vault with Face ID."
        }
      ],
      "react-native-quick-crypto",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan 2FA QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiServers": [
        "https://password-manager-server-xxdr.onrender.com",
        "https://password-manager-server-8gvj.onrender.com"
      ],
      "router": {},
      "eas": {
        "projectId": "37f23494-462b-4541-8ec2-82ff0616887a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "tanushhhh18"
  }
}
