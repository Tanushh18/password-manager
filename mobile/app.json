{
  "expo": {
    "name": "Aurelia",
    "slug": "aurelia-vault",
    "scheme": "aurelia",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07061A",
    "description": "Aurelia \u2014 a glowing, private vault for every password. Same account and server as the Aurelia website.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurelia.vault"
    },
    "android": {
      "package": "com.aurelia.vault",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6D28D9"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07061A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock your vault with Face ID."
        }
      ],
      "react-native-quick-crypto",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan 2FA QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiServers": [
        "https://password-manager-server-xxdr.onrender.com",
        "https://password-manager-server-8gvj.onrender.com"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
