{
  "expo": {
    "name": "Stashr",
    "slug": "aurelia-vault",
    "scheme": "stashr",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1113",
    "description": "Stashr — a private vault for every password and project. Same account and server as the Stashr website.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tanush.stashr.com"
    },
    "android": {
      "package": "com.tanush.stashr.com",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#31AAA9"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1113",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock your vault with Face ID."
        }
      ],
      "react-native-quick-crypto",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan 2FA QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to find new photos and videos so it can back them up to your Google Drive."
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.stashrsms.** { *; }\n-keep class com.margelo.** { *; }\n-keep class com.swmansion.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-dontwarn org.bouncycastle.**\n-dontwarn org.conscrypt.**\n-dontwarn org.openjsse.**\n-dontwarn javax.annotation.**\n-dontwarn com.google.errorprone.annotations.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiServers": [
        "https://password-manager-server-g305.onrender.com",
        "https://password-manager-server-xxdr.onrender.com"
      ],
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "tanushhhhh18"
  }
}
